<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Foreground service that keeps downloads alive when minimized / screen off.
       Permissions (FOREGROUND_SERVICE, FOREGROUND_SERVICE_DATA_SYNC, WAKE_LOCK…)
       are added to the app manifest by plugins/withYtPluckAndroid.js. -->
  <service
      android:name=".DownloadService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

</manifest>